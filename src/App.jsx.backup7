import { useState, useMemo } from "react";

const INDS = [
  { id: "mfg",   label: "PMI Manuf",    thresh: 2.0,  rev: false, w: 0.10 },
  { id: "svc",   label: "PMI Services", thresh: 2.0,  rev: false, w: 0.15 },
  { id: "unemp", label: "Chomage %",    thresh: 0.3,  rev: true,  w: 0.20 },
  { id: "rate",  label: "Taux %",       thresh: 0.25, rev: false, w: 0.05 },
  { id: "cpi",   label: "Inflation %",  thresh: 0.3,  rev: false, w: 0.25 },
  { id: "core",  label: "Core CPI %",   thresh: 0.2,  rev: false, w: 0.25 },
];

const TE = "https://tradingeconomics.com";
const TE_LINKS = {
  USD: { mfg:"united-states/manufacturing-pmi", svc:"united-states/services-pmi", unemp:"united-states/unemployment-rate", rate:"united-states/interest-rate", cpi:"united-states/inflation-cpi", core:"united-states/core-inflation-rate" },
  EUR: { mfg:"euro-area/manufacturing-pmi", svc:"euro-area/services-pmi", unemp:"euro-area/unemployment-rate", rate:"euro-area/interest-rate", cpi:"euro-area/inflation-rate", core:"euro-area/core-inflation-rate" },
  CAD: { mfg:"canada/manufacturing-pmi", svc:"canada/services-pmi", unemp:"canada/unemployment-rate", rate:"canada/interest-rate", cpi:"canada/inflation-rate", core:"canada/core-inflation-rate" },
  CHF: { mfg:"switzerland/manufacturing-pmi", svc:"switzerland/services-pmi", unemp:"switzerland/unemployment-rate", rate:"switzerland/interest-rate", cpi:"switzerland/inflation-rate", core:"switzerland/core-inflation-rate" },
  AUD: { mfg:"australia/manufacturing-pmi", svc:"australia/services-pmi", unemp:"australia/unemployment-rate", rate:"australia/interest-rate", cpi:"australia/inflation-rate", core:"australia/core-inflation-rate" },
  JPY: { mfg:"japan/manufacturing-pmi", svc:"japan/services-pmi", unemp:"japan/unemployment-rate", rate:"japan/interest-rate", cpi:"japan/inflation-rate", core:"japan/core-inflation-rate" },
  GBP: { mfg:"united-kingdom/manufacturing-pmi", svc:"united-kingdom/services-pmi", unemp:"united-kingdom/unemployment-rate", rate:"united-kingdom/interest-rate", cpi:"united-kingdom/inflation-rate", core:"united-kingdom/core-inflation-rate" },
  NZD: { mfg:"new-zealand/manufacturing-pmi", svc:"new-zealand/services-pmi", unemp:"new-zealand/unemployment-rate", rate:"new-zealand/interest-rate", cpi:"new-zealand/inflation-rate", core:"new-zealand/core-inflation-rate" },
  CNY: { mfg:"china/manufacturing-pmi", svc:"china/services-pmi", unemp:"china/unemployment-rate", rate:"china/interest-rate", cpi:"china/inflation-rate", core:"china/core-inflation-rate" },
};

const CURR = [
  { code:"USD", flag:"🇺🇸", label:"Etats-Unis" },
  { code:"EUR", flag:"🇪🇺", label:"Zone Euro" },
  { code:"CAD", flag:"🇨🇦", label:"Canada" },
  { code:"CHF", flag:"🇨🇭", label:"Suisse" },
  { code:"AUD", flag:"🇦🇺", label:"Australie" },
  { code:"JPY", flag:"🇯🇵", label:"Japon" },
  { code:"GBP", flag:"🇬🇧", label:"Royaume-Uni" },
  { code:"NZD", flag:"🇳🇿", label:"Nvl-Zelande" },
  { code:"CNY", flag:"🇨🇳", label:"Chine" },
];

// Convention Forex standard
const PAIR_ORDER = ["EUR","GBP","AUD","NZD","USD","CAD","CHF","JPY","CNY"];

function mkData() {
  const d = {};
  CURR.forEach(c => { d[c.code] = {}; INDS.forEach(i => { d[c.code][i.id] = { prior:"", exp:"", now:"" }; }); });
  return d;
}

function toN(v) { const n = parseFloat(v); return isNaN(n) ? null : n; }

function getSurprise(ind, cell) {
  const n = toN(cell.now), e = toN(cell.exp);
  if (n === null || e === null) return null;
  return ind.rev ? -(n - e) : (n - e);
}

function getMag(ind, surp) { return Math.max(-1, Math.min(1, surp / ind.thresh)); }

function hasData(data, code) {
  return INDS.some(ind => toN(data[code][ind.id].now) !== null);
}

function calcScore(data, code) {
  let total = 0, wTotal = 0;
  INDS.forEach(ind => {
    const cell = data[code][ind.id];
    let s;
    if (ind.id === "rate") {
      const now = toN(cell.now), prior = toN(cell.prior);
      if (now === null || prior === null) return;
      s = now - prior;
    } else {
      s = getSurprise(ind, cell);
    }
    if (s === null) return;
    total += getMag(ind, s) * ind.w;
    wTotal += ind.w;
  });
  return wTotal === 0 ? 0 : total / wTotal * wTotal;
}

function getRegime(data, code) {
  const score = calcScore(data, code);
  if (!hasData(data, code)) return null;

  // Score inflation
  const cpiInd = INDS.find(i=>i.id==="cpi");
  const coreInd = INDS.find(i=>i.id==="core");
  const unempInd = INDS.find(i=>i.id==="unemp");
  const cpiS = getSurprise(cpiInd, data[code]["cpi"]);
  const coreS = getSurprise(coreInd, data[code]["core"]);
  const unempS = getSurprise(unempInd, data[code]["unemp"]);

  let infScore = 0, infW = 0;
  if (cpiS !== null) { infScore += getMag(cpiInd, cpiS) * 0.25; infW += 0.25; }
  if (coreS !== null) { infScore += getMag(coreInd, coreS) * 0.25; infW += 0.25; }
  const infNorm = infW > 0 ? infScore / infW : 0;

  // Score croissance (score global - inflation)
  const growthNorm = score - infScore;

  const infUp = infNorm > 0.05;
  const growthUp = growthNorm > 0.02;

  if (growthUp && !infUp)  return { label:"GOLDILOCKS",  color:"#22c55e", bg:"#052e16", border:"#22c55e", icon:"🟢" };
  if (growthUp && infUp)   return { label:"SURCHAUFFE",  color:"#f59e0b", bg:"#422006", border:"#f59e0b", icon:"🟡" };
  if (!growthUp && infUp)  return { label:"STAGFLATION", color:"#ef4444", bg:"#450a0a", border:"#ef4444", icon:"🔴" };
  return                          { label:"RECESSION",   color:"#f97316", bg:"#431407", border:"#f97316", icon:"🟠" };
}

function getPairName(codeA, codeB) {
  const iA = PAIR_ORDER.indexOf(codeA);
  const iB = PAIR_ORDER.indexOf(codeB);
  return iA <= iB ? codeA+"/"+codeB : codeB+"/"+codeA;
}

function isPairLongFirst(strong, weak) {
  const pair = getPairName(strong.code, weak.code);
  return pair.startsWith(strong.code);
}

function cellBg(surp, ind) {
  if (surp === null) return "#111827";
  const m = getMag(ind, surp);
  if (m > 0.5) return "#14532d"; if (m > 0) return "#166534";
  if (m < -0.5) return "#7f1d1d"; if (m < 0) return "#991b1b";
  return "#1f2937";
}

function cellClr(surp, ind) {
  if (surp === null) return "#e2f0ff";
  const m = getMag(ind, surp);
  if (m > 0.5) return "#4ade80"; if (m > 0) return "#86efac";
  if (m < -0.5) return "#f87171"; if (m < 0) return "#fca5a5";
  return "#fbbf24";
}

function getStr(score) {
  if (score >= 0.35)  return { label:"FORT",   color:"#22c55e", bg:"#14532d" };
  if (score >= 0.10)  return { label:"MODERE", color:"#86efac", bg:"#166534" };
  if (score <= -0.35) return { label:"FAIBLE", color:"#ef4444", bg:"#7f1d1d" };
  if (score <= -0.10) return { label:"MODERE", color:"#fca5a5", bg:"#991b1b" };
  return                     { label:"NEUTRE", color:"#fbbf24", bg:"#1f2937" };
}

function getBCBias(regime) {
  if (!regime) return { bc:"Donnees insuffisantes", devise:"—", action:"—", taux:"—" };
  const map = {
    GOLDILOCKS:  { bc:"NEUTRE a HAWKISH modere", taux:"Taux stables ou legere hausse", devise:"HAUSSE — croissance sans inflation = ideal", action:"ACHETE la devise — setup ideal" },
    SURCHAUFFE:  { bc:"HAWKISH — va monter les taux", taux:"Hausse des taux imminente", devise:"HAUSSE court terme — surveille retournement", action:"ACHETE — mais surveille le retournement" },
    STAGFLATION: { bc:"COINCEE — ne peut pas agir", taux:"Taux bloques — BC prise en etau", devise:"BAISSE — pire scenario", action:"VENDS la devise — evite le long" },
    RECESSION:   { bc:"DOVISH — va baisser les taux", taux:"Baisse des taux imminente", devise:"BAISSE — capitaux fuient l economie", action:"VENDS la devise — short setup" },
  };
  return map[regime.label] || map.RECESSION;
}

function Inp({ code, id, field, data, setCell }) {
  const cell = data[code][id];
  const ind  = INDS.find(i => i.id === id);
  let surp = null;
  if (field === "now") {
    if (id === "rate") {
      const now = toN(cell.now), prior = toN(cell.prior);
      surp = (now !== null && prior !== null) ? now - prior : null;
    } else {
      surp = getSurprise(ind, cell);
    }
  }
  return (
    <input type="number" step="0.01" value={cell[field]}
      onChange={e => setCell(code, id, field, e.target.value)}
      placeholder="-"
      style={{ width:44, background: field==="now" ? cellBg(surp, ind) : "#111827",
        border:"1px solid #1e3a5f44", borderRadius:3,
        color: field==="now" ? cellClr(surp, ind) : "#94a3b8",
        padding:"3px 2px", fontSize:11, fontFamily:"monospace",
        outline:"none", textAlign:"center", fontWeight: field==="now" ? 700 : 400 }}
    />
  );
}

function RegimeCard({ curr, data }) {
  const [open, setOpen] = useState(false);
  const regime = getRegime(data, curr.code);
  const score = calcScore(data, curr.code);
  const st = getStr(score);
  const bias = getBCBias(regime);
  const hasDat = hasData(data, curr.code);

  return (
    <div style={{ marginBottom:8, borderRadius:8, overflow:"hidden", border:"1px solid "+(regime ? regime.border+"55" : "#1e3a5f33") }}>
      {/* Header */}
      <div onClick={() => hasDat && setOpen(o=>!o)}
        style={{ display:"flex", alignItems:"center", gap:10, padding:"12px 16px",
          background: regime ? regime.bg : "#0a1628",
          cursor: hasDat ? "pointer" : "default" }}>
        <span style={{ fontSize:20 }}>{curr.flag}</span>
        <div style={{ flex:1 }}>
          <div style={{ fontWeight:700, color:"#e2f0ff", fontSize:13, letterSpacing:1 }}>{curr.code}</div>
          <div style={{ fontSize:9, color:"#64748b" }}>{curr.label}</div>
        </div>
        {regime
          ? <div style={{ textAlign:"right" }}>
              <div style={{ fontSize:11, fontWeight:700, color:regime.color, background:regime.bg, border:"1px solid "+regime.border+"55", borderRadius:4, padding:"3px 10px", marginBottom:2 }}>{regime.icon} {regime.label}</div>
              <div style={{ fontSize:10, fontWeight:700, color:st.color }}>{score>=0?"+":""}{score.toFixed(2)}</div>
            </div>
          : <div style={{ fontSize:10, color:"#475569", fontStyle:"italic" }}>Aucune donnee saisie</div>
        }
        {hasDat && <span style={{ fontSize:10, color:"#475569" }}>{open?"▲":"▼"}</span>}
      </div>

      {/* Detail */}
      {open && regime && (
        <div style={{ background:"#070b14", borderTop:"1px solid "+regime.border+"22", padding:"14px 16px" }}>

          {/* BANQUE CENTRALE / DEVISE */}
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:10 }}>
            <div style={{ padding:"10px 12px", background:regime.bg, borderRadius:6, border:"1px solid "+regime.border+"44" }}>
              <div style={{ fontSize:9, color:regime.color, fontWeight:700, letterSpacing:2, marginBottom:6 }}>BANQUE CENTRALE</div>
              <div style={{ fontSize:11, color:"#e2f0ff", fontWeight:600 }}>{bias.bc}</div>
            </div>
            <div style={{ padding:"10px 12px", background:regime.bg, borderRadius:6, border:"1px solid "+regime.border+"44" }}>
              <div style={{ fontSize:9, color:regime.color, fontWeight:700, letterSpacing:2, marginBottom:6 }}>DEVISE</div>
              <div style={{ fontSize:11, color:"#e2f0ff", fontWeight:600 }}>{bias.devise.split("—")[0]}</div>
            </div>
          </div>

          {/* TAUX D INTERET */}
          <div style={{ padding:"10px 12px", background:regime.bg, borderRadius:6, border:"1px solid "+regime.border+"44", marginBottom:10 }}>
            <div style={{ fontSize:9, color:regime.color, fontWeight:700, letterSpacing:2, marginBottom:4 }}>TAUX D INTERET</div>
            <div style={{ fontSize:11, color:"#e2f0ff" }}>{bias.taux}</div>
          </div>

          {/* POURQUOI CE REGIME */}
          <div style={{ padding:"10px 12px", background:"#0a1628", borderRadius:6, border:"1px solid "+regime.border+"33", marginBottom:10 }}>
            <div style={{ fontSize:9, color:regime.color, fontWeight:700, letterSpacing:2, marginBottom:8 }}>POURQUOI CE REGIME</div>
            {INDS.map(ind => {
              const cell = data[curr.code][ind.id];
              if (ind.id === "rate") {
                const now = toN(cell.now), prior = toN(cell.prior);
                if (now === null) return null;
                const diff = prior !== null ? now - prior : null;
                const col = diff === null ? "#38bdf8" : diff > 0 ? "#4ade80" : diff < 0 ? "#f87171" : "#fbbf24";
                return (
                  <div key={ind.id} style={{ display:"flex", alignItems:"flex-start", gap:8, marginBottom:6 }}>
                    <span style={{ color:col, fontSize:10 }}>●</span>
                    <div style={{ fontSize:10, color:"#94a3b8", flex:1 }}>
                      <span style={{ color:"#e2f0ff", fontWeight:700 }}>Taux: {now}%</span>
                      {prior !== null && <span> (precedent: {prior}%) — {diff > 0 ? "hausse → hawkish" : diff < 0 ? "baisse → dovish" : "stable"}</span>}
                    </div>
                  </div>
                );
              }
              const s = getSurprise(ind, cell);
              if (s === null) return null;
              const m = getMag(ind, s);
              const beat = ind.rev ? s > 0 : s > 0;
              const col = m > 0 ? "#4ade80" : m < 0 ? "#f87171" : "#fbbf24";
              const now = toN(cell.now), exp = toN(cell.exp);
              const interp = ind.id==="unemp"
                ? (s>0 ? "chomage baisse → economie forte → hawkish" : "chomage monte → economie faible → dovish")
                : ind.id==="cpi"||ind.id==="core"
                  ? (s>0 ? "au-dessus cible → hawkish" : "sous cible → dovish")
                  : (s>0 ? "expansion forte" : "contraction");
              return (
                <div key={ind.id} style={{ display:"flex", alignItems:"flex-start", gap:8, marginBottom:6 }}>
                  <span style={{ color:col, fontSize:10 }}>●</span>
                  <div style={{ fontSize:10, color:"#94a3b8", flex:1 }}>
                    <span style={{ color:"#e2f0ff", fontWeight:700 }}>{ind.label}: {now}</span>
                    <span style={{ color:"#64748b" }}> (exp:{exp}) </span>
                    <span style={{ color:col, fontWeight:700 }}>{beat?"BEAT ✅":"MISS ❌"} ({s>0?"+":""}{s.toFixed(2)})</span>
                    <span style={{ color:"#64748b" }}> → {interp}</span>
                  </div>
                </div>
              );
            })}
          </div>

          {/* ACTION */}
          <div style={{ padding:"10px 12px", background:regime.bg, borderRadius:6, border:"1px solid "+regime.border+"66" }}>
            <div style={{ fontSize:9, color:regime.color, fontWeight:700, letterSpacing:2, marginBottom:4 }}>ACTION RECOMMANDEE</div>
            <div style={{ fontSize:12, color:regime.color, fontWeight:700 }}>{bias.action}</div>
          </div>
        </div>
      )}
    </div>
  );
}

function TradeCard({ pair, strong, weak, div, regS, regW }) {
  const [open, setOpen] = useState(false);
  const pairName = getPairName(strong.code, weak.code);
  const longFirst = isPairLongFirst(strong, weak);
  const ok = div >= 0.25;
  const great = div >= 0.40;
  const perfect = regS && regW &&
    ["GOLDILOCKS","SURCHAUFFE"].includes(regS.label) &&
    ["RECESSION","STAGFLATION"].includes(regW.label);
  const borderCol = perfect ? "#a855f7" : great ? "#22c55e" : ok ? "#f59e0b" : "#475569";
  const label = perfect ? "⭐ PARFAIT" : great ? "✓ FORT" : ok ? "~ MODERE" : "✗ FAIBLE";

  const biasS = getBCBias(regS);
  const biasW = getBCBias(regW);

  return (
    <div style={{ marginBottom:10, borderRadius:8, overflow:"hidden", border:"2px solid "+borderCol+"66" }}>
      {/* Header paire */}
      <div onClick={() => setOpen(o=>!o)}
        style={{ display:"flex", alignItems:"center", gap:10, padding:"12px 16px", background:"#0a1628", cursor:"pointer" }}>
        <div style={{ display:"flex", alignItems:"center", gap:6 }}>
          <span style={{ fontSize:18 }}>{strong.flag}</span>
          <div>
            <div style={{ fontSize:11, fontWeight:700, color:"#22c55e" }}>{strong.code}</div>
            {regS && <div style={{ fontSize:8, color:regS.color }}>{regS.icon} {regS.label}</div>}
          </div>
        </div>
        <div style={{ flex:1, textAlign:"center" }}>
          <div style={{ fontSize:9, color:"#475569", marginBottom:2 }}>
            {longFirst ? "LONG "+strong.code+" / SHORT "+weak.code : "SHORT "+weak.code+" / LONG "+strong.code}
          </div>
          <div style={{ fontSize:18, fontWeight:700, color:borderCol }}>{pairName}</div>
          <div style={{ fontSize:9, fontWeight:700, color:borderCol }}>{label}</div>
        </div>
        <div style={{ display:"flex", alignItems:"center", gap:6 }}>
          <div style={{ textAlign:"right" }}>
            <div style={{ fontSize:11, fontWeight:700, color:"#ef4444" }}>{weak.code}</div>
            {regW && <div style={{ fontSize:8, color:regW.color }}>{regW.icon} {regW.label}</div>}
          </div>
          <span style={{ fontSize:18 }}>{weak.flag}</span>
        </div>
        <div style={{ minWidth:40, textAlign:"right" }}>
          <div style={{ fontSize:15, fontWeight:700, color:borderCol }}>{div.toFixed(2)}</div>
          <div style={{ fontSize:8, color:"#475569" }}>{open?"▲":"▼"}</div>
        </div>
      </div>

      {/* Detail */}
      {open && (
        <div style={{ background:"#070b14", borderTop:"1px solid "+borderCol+"22", padding:"14px 16px" }}>

          {/* Les 2 devises cote a cote */}
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:12 }}>
            {/* Devise forte */}
            <div style={{ padding:"10px 12px", background:regS ? regS.bg : "#0a1628", borderRadius:6, border:"1px solid "+(regS ? regS.border : "#22c55e")+"44" }}>
              <div style={{ fontSize:9, color:"#22c55e", fontWeight:700, letterSpacing:2, marginBottom:6 }}>DEVISE FORTE — LONG</div>
              <div style={{ fontSize:14, fontWeight:700, color:"#e2f0ff", marginBottom:4 }}>{strong.flag} {strong.code}</div>
              {regS && <div style={{ fontSize:10, color:regS.color, fontWeight:700, marginBottom:4 }}>{regS.icon} {regS.label}</div>}
              <div style={{ fontSize:10, color:"#94a3b8", marginBottom:2 }}>BC: {biasS.bc}</div>
              <div style={{ fontSize:10, color:"#94a3b8", marginBottom:4 }}>Taux: {biasS.taux}</div>
              <div style={{ fontSize:11, color:"#22c55e", fontWeight:700 }}>→ {biasS.action.split("—")[0]}</div>
            </div>
            {/* Devise faible */}
            <div style={{ padding:"10px 12px", background:regW ? regW.bg : "#0a1628", borderRadius:6, border:"1px solid "+(regW ? regW.border : "#ef4444")+"44" }}>
              <div style={{ fontSize:9, color:"#ef4444", fontWeight:700, letterSpacing:2, marginBottom:6 }}>DEVISE FAIBLE — SHORT</div>
              <div style={{ fontSize:14, fontWeight:700, color:"#e2f0ff", marginBottom:4 }}>{weak.flag} {weak.code}</div>
              {regW && <div style={{ fontSize:10, color:regW.color, fontWeight:700, marginBottom:4 }}>{regW.icon} {regW.label}</div>}
              <div style={{ fontSize:10, color:"#94a3b8", marginBottom:2 }}>BC: {biasW.bc}</div>
              <div style={{ fontSize:10, color:"#94a3b8", marginBottom:4 }}>Taux: {biasW.taux}</div>
              <div style={{ fontSize:11, color:"#ef4444", fontWeight:700 }}>→ {biasW.action.split("—")[0]}</div>
            </div>
          </div>

          {/* Direction + divergence */}
          <div style={{ padding:"10px 12px", background:"#0a1628", borderRadius:6, border:"1px solid "+borderCol+"33", marginBottom:10 }}>
            <div style={{ fontSize:9, color:borderCol, fontWeight:700, letterSpacing:2, marginBottom:6 }}>DIRECTION DU TRADE</div>
            <div style={{ fontSize:13, fontWeight:700, color:borderCol, marginBottom:4 }}>
              {longFirst ? "↑ LONG "+pairName : "↑ LONG "+pairName+" (achete "+strong.code+")"}
            </div>
            <div style={{ display:"flex", gap:8, alignItems:"center", marginTop:6 }}>
              <div style={{ flex:1, height:6, background:"#1e3a5f", borderRadius:3 }}>
                <div style={{ width:Math.min(div*100/0.8,100)+"%", height:"100%", background:borderCol, borderRadius:3 }} />
              </div>
              <span style={{ fontSize:13, fontWeight:700, color:borderCol }}>{div.toFixed(2)}</span>
            </div>
            <div style={{ fontSize:9, color:"#64748b", marginTop:4 }}>
              {div >= 0.60 ? "Position MAXIMUM" : div >= 0.40 ? "Position normale" : div >= 0.25 ? "Petite position" : "Ne trade pas — trop faible"}
            </div>
          </div>

          {/* Anticipation BC */}
          <div style={{ padding:"10px 12px", background:"#0a1628", borderRadius:6, border:"1px solid #38bdf833" }}>
            <div style={{ fontSize:9, color:"#38bdf8", fontWeight:700, letterSpacing:2, marginBottom:6 }}>ANTICIPATION BANQUES CENTRALES</div>
            <div style={{ fontSize:10, color:"#94a3b8", marginBottom:4 }}>
              <span style={{ color:"#22c55e", fontWeight:700 }}>{strong.code}</span>: {biasS.taux} → devise devrait <span style={{ color:"#22c55e" }}>monter</span>
            </div>
            <div style={{ fontSize:10, color:"#94a3b8", marginBottom:4 }}>
              <span style={{ color:"#ef4444", fontWeight:700 }}>{weak.code}</span>: {biasW.taux} → devise devrait <span style={{ color:"#ef4444" }}>baisser</span>
            </div>
            {perfect && <div style={{ marginTop:6, fontSize:10, color:"#a855f7", fontWeight:700 }}>⭐ Regimes opposes confirmes — setup institutionnel ideal</div>}
          </div>
        </div>
      )}
    </div>
  );
}

function DataView() {
  const [selected, setSelected] = useState("USD");
  const curr = CURR.find(c => c.code === selected);
  return (
    <div style={{ padding:16 }}>
      <div style={{ background:"#0a1628", border:"1px solid #38bdf844", borderRadius:8, padding:16, marginBottom:12 }}>
        <div style={{ fontSize:12, letterSpacing:3, color:"#38bdf8", fontWeight:700, marginBottom:8, borderBottom:"1px solid #38bdf833", paddingBottom:8 }}>LIENS TRADING ECONOMICS</div>
        <div style={{ fontSize:10, color:"#64748b", marginBottom:12 }}>
          Clique sur une devise → clique sur l indicateur → tu vois <span style={{color:"#f59e0b"}}>Previous</span> / <span style={{color:"#38bdf8"}}>Consensus</span> / <span style={{color:"#4ade80"}}>Actual</span>
        </div>
        <div style={{ display:"flex", flexWrap:"wrap", gap:6, marginBottom:16 }}>
          {CURR.map(c => (
            <button key={c.code} onClick={() => setSelected(c.code)}
              style={{ padding:"6px 12px", fontSize:11, fontWeight:700, cursor:"pointer", borderRadius:4,
                border: selected===c.code ? "1px solid #38bdf8" : "1px solid #1e3a5f",
                background: selected===c.code ? "#38bdf820" : "#070b14",
                color: selected===c.code ? "#38bdf8" : "#64748b" }}>
              {c.flag} {c.code}
            </button>
          ))}
        </div>
        <div style={{ padding:12, background:"#070b14", borderRadius:6, border:"1px solid #1e3a5f33" }}>
          <div style={{ fontSize:12, fontWeight:700, color:"#e2f0ff", marginBottom:12 }}>{curr.flag} {curr.code} — {curr.label}</div>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill, minmax(160px, 1fr))", gap:8 }}>
            {INDS.map(ind => (
              <a key={ind.id} href={TE+"/"+TE_LINKS[curr.code][ind.id]} target="_blank" rel="noopener noreferrer"
                style={{ display:"flex", flexDirection:"column", padding:"10px 12px", borderRadius:6,
                  background:"#0a1628", border:"1px solid #38bdf833", color:"#38bdf8", textDecoration:"none" }}>
                <span style={{ fontSize:11, fontWeight:700, marginBottom:4 }}>{ind.label} ↗</span>
                <span style={{ fontSize:8, color:"#475569" }}>{TE_LINKS[curr.code][ind.id]}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div style={{ background:"#0a1628", border:"1px solid #f59e0b44", borderRadius:8, padding:16 }}>
        <div style={{ fontSize:12, letterSpacing:3, color:"#f59e0b", fontWeight:700, marginBottom:8, borderBottom:"1px solid #f59e0b33", paddingBottom:8 }}>COMMENT SAISIR</div>
        {[["Previous","#f59e0b","Le chiffre du mois dernier → colonne PRIOR"],["Consensus","#38bdf8","Ce que les economistes prevoient → colonne EXP"],["Actual","#4ade80","Le chiffre publie → colonne NOW"]].map(([k,col,v]) => (
          <div key={k} style={{ display:"flex", gap:12, marginBottom:8 }}>
            <div style={{ fontSize:10, fontWeight:700, color:col, minWidth:80 }}>{k}</div>
            <div style={{ fontSize:10, color:"#94a3b8" }}>{v}</div>
          </div>
        ))}
        <div style={{ marginTop:10, padding:10, background:"#070b14", borderRadius:6, border:"1px solid #f59e0b33" }}>
          <div style={{ fontSize:10, fontWeight:700, color:"#f59e0b", marginBottom:4 }}>⚠️ TAUX — SPECIAL</div>
          <div style={{ fontSize:10, color:"#94a3b8" }}>Entre le taux actuel dans NOW et le taux precedent dans PRIOR. Pas besoin de EXP pour le taux.</div>
        </div>
      </div>
    </div>
  );
}

function GuideView() {
  const sections = [
    { title:"CORE CPI %", sub:"Core Inflation Rate sur Trading Economics", desc:"Le plus important — la BC regarde ca en premier.", good:"PLUS HAUT que prevu = BC monte les taux = devise monte", bad:"PLUS BAS que prevu = BC baisse les taux = devise baisse", pct:"25%" },
    { title:"INFLATION %", sub:"Inflation Rate sur Trading Economics", desc:"Confirme le Core CPI. Inclut nourriture, essence, loyer.", good:"Les 2 BEATS = signal hawkish tres fort", bad:"Les 2 MISS = signal dovish tres fort", pct:"25%" },
    { title:"CHOMAGE %", sub:"Unemployment Rate sur Trading Economics", desc:"INVERSE — chiffre BAS = bon. Moins de chomage = gens depensent = prix montent.", good:"PLUS BAS que prevu = economie forte = devise monte", bad:"PLUS HAUT que prevu = economie faible = devise baisse", pct:"20%" },
    { title:"PMI SERVICES", sub:"Services PMI sur Trading Economics", desc:"75% de l economie. Au-dessus de 50 = expansion.", good:"PLUS HAUT que prevu = demande forte = hawkish", bad:"PLUS BAS que prevu = demande faible = dovish", pct:"15%" },
    { title:"PMI MANUF", sub:"Manufacturing PMI sur Trading Economics", desc:"Premier signal d un ralentissement.", good:"PLUS HAUT que prevu = production forte", bad:"PLUS BAS que prevu = ralentissement", pct:"10%" },
    { title:"TAUX %", sub:"Interest Rate sur Trading Economics", desc:"Entre NOW et PRIOR. Hausse = hawkish. La devise avec le taux le plus haut attire les capitaux.", good:"Hausse du taux = capitaux entrent = devise monte", bad:"Baisse du taux = capitaux sortent = devise baisse", pct:"5%" },
  ];
  return (
    <div style={{ padding:16 }}>
      <div style={{ background:"#0a1628", border:"1px solid #1e3a5f", borderRadius:8, padding:16, marginBottom:12 }}>
        <div style={{ fontSize:12, letterSpacing:3, color:"#38bdf8", fontWeight:700, marginBottom:16, borderBottom:"1px solid #1e3a5f", paddingBottom:8 }}>DANS LA TETE DE LA BANQUE CENTRALE</div>
        {sections.map(s => (
          <div key={s.title} style={{ marginBottom:12, padding:12, background:"#070b14", borderRadius:6, border:"1px solid #1e3a5f33" }}>
            <div style={{ display:"flex", justifyContent:"space-between", marginBottom:4 }}>
              <div style={{ fontSize:12, fontWeight:700, color:"#38bdf8" }}>{s.title}</div>
              <div style={{ fontSize:10, fontWeight:700, color:"#475569" }}>Poids {s.pct}</div>
            </div>
            <div style={{ fontSize:9, color:"#475569", marginBottom:6 }}>{s.sub}</div>
            <div style={{ fontSize:10, color:"#94a3b8", marginBottom:8 }}>{s.desc}</div>
            <div style={{ fontSize:10, color:"#4ade80", marginBottom:3 }}>✅ {s.good}</div>
            <div style={{ fontSize:10, color:"#f87171" }}>❌ {s.bad}</div>
          </div>
        ))}
      </div>
      <div style={{ background:"#0a1628", border:"1px solid #a855f744", borderRadius:8, padding:16, marginBottom:12 }}>
        <div style={{ fontSize:12, letterSpacing:3, color:"#a855f7", fontWeight:700, marginBottom:12, borderBottom:"1px solid #a855f733", paddingBottom:8 }}>REGIMES MACRO</div>
        {[
          ["🟢 GOLDILOCKS","Croissance forte + Inflation basse","BC neutre/hawkish modere","Devise MONTE — setup ideal","#22c55e"],
          ["🟡 SURCHAUFFE","Croissance forte + Inflation haute","BC hawkish — monte les taux","Devise MONTE court terme","#f59e0b"],
          ["🔴 STAGFLATION","Croissance faible + Inflation haute","BC coincee — ne peut pas agir","Devise BAISSE — evite","#ef4444"],
          ["🟠 RECESSION","Croissance faible + Inflation basse","BC dovish — baisse les taux","Devise BAISSE — short setup","#f97316"],
        ].map(([r,sig,bc,act,col]) => (
          <div key={r} style={{ marginBottom:8, padding:10, background:"#070b14", borderRadius:6, border:"1px solid "+col+"33" }}>
            <div style={{ fontSize:11, fontWeight:700, color:col, marginBottom:4 }}>{r}</div>
            <div style={{ fontSize:10, color:"#38bdf8", marginBottom:2 }}>Signal: {sig}</div>
            <div style={{ fontSize:10, color:"#94a3b8", marginBottom:2 }}>BC: {bc}</div>
            <div style={{ fontSize:10, color:col, fontWeight:700 }}>→ {act}</div>
          </div>
        ))}
      </div>
      <div style={{ background:"#0a1628", border:"1px solid #f59e0b44", borderRadius:8, padding:16 }}>
        <div style={{ fontSize:12, letterSpacing:3, color:"#f59e0b", fontWeight:700, marginBottom:12, borderBottom:"1px solid #f59e0b33", paddingBottom:8 }}>REGLE D OR BC</div>
        {[["1 mois de beat","Elle note mais n agit pas"],["2 mois de beats","Elle commence a en parler"],["3 mois de beats","Elle agit — c est la que ca bouge"]].map(([r,d]) => (
          <div key={r} style={{ display:"flex", gap:12, marginBottom:8 }}>
            <div style={{ fontSize:10, fontWeight:700, color:"#f59e0b", minWidth:130 }}>{r}</div>
            <div style={{ fontSize:10, color:"#94a3b8" }}>{d}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

function CalView() {
  const SECTIONS = [
    { title:"CALENDRIER ECONOMIQUE", color:"#38bdf8", links:[
      { label:"Babypips Economic Calendar", url:"https://www.babypips.com/economic-calendar", desc:"Evenements HIGH impact" },
      { label:"Forex Factory Calendar", url:"https://www.forexfactory.com/calendar", desc:"Calendrier complet" },
    ]},
    { title:"ANALYSE FX", color:"#a855f7", links:[
      { label:"ING Think FX", url:"https://think.ing.com/market/fx/", desc:"Analyse macro FX quotidienne" },
      { label:"Sucden Financial", url:"https://www.sucdenfinancial.com/en/market-insights/fx-outlook/daily-fx-analysis/", desc:"Analyse technique et fondamentale" },
    ]},
    { title:"SENTIMENT & FORCE", color:"#22c55e", links:[
      { label:"Babypips Market Milk", url:"https://marketmilk.babypips.com/currency-strength", desc:"Force relative des devises" },
      { label:"Myfxbook Outlook", url:"https://www.myfxbook.com/community/outlook", desc:"Sentiment retail" },
    ]},
    { title:"COT & POSITIONNEMENT", color:"#f59e0b", links:[
      { label:"Tradingster COT", url:"https://www.tradingster.com/cot", desc:"Positionnement institutionnel CFTC" },
    ]},
  ];
  return (
    <div style={{ padding:16 }}>
      {SECTIONS.map(s => (
        <div key={s.title} style={{ background:"#0a1628", border:"1px solid "+s.color+"44", borderRadius:8, padding:16, marginBottom:12 }}>
          <div style={{ fontSize:11, letterSpacing:3, color:s.color, fontWeight:700, marginBottom:12, borderBottom:"1px solid "+s.color+"33", paddingBottom:8 }}>{s.title}</div>
          {s.links.map(l => (
            <a key={l.url} href={l.url} target="_blank" rel="noopener noreferrer"
              style={{ display:"flex", justifyContent:"space-between", alignItems:"center", padding:"10px 12px", marginBottom:6, background:"#070b14", borderRadius:6, border:"1px solid "+s.color+"22", textDecoration:"none" }}>
              <div>
                <div style={{ fontSize:11, fontWeight:700, color:s.color }}>{l.label} ↗</div>
                <div style={{ fontSize:9, color:"#475569", marginTop:2 }}>{l.desc}</div>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
  );
}

export default function App() {
  const [data, setData] = useState(() => { try { const s = localStorage.getItem("apexdata"); return s ? JSON.parse(s) : mkData(); } catch { return mkData(); } });
  const [view, setView] = useState("table");

  function setCell(code, id, field, val) {
    setData(p => { const n={...p}; n[code]={...p[code]}; n[code][id]={...p[code][id],[field]:val}; localStorage.setItem("apexdata", JSON.stringify(n)); return n; });
  }

  function resetData() {
    if (confirm("Effacer toutes les donnees?")) { const d=mkData(); localStorage.setItem("apexdata",JSON.stringify(d)); setData(d); }
  }

  const ranked = useMemo(() =>
    CURR.map(c => ({ ...c, score:calcScore(data, c.code) })).sort((a,b) => b.score - a.score)
  , [data]);

  const withData = ranked.filter(c => hasData(data, c.code));

  const allPairs = useMemo(() => {
    const pairs = [];
    for (let i = 0; i < withData.length; i++) {
      for (let j = i+1; j < withData.length; j++) {
        const a = withData[i], b = withData[j];
        const strong = a.score >= b.score ? a : b;
        const weak   = a.score >= b.score ? b : a;
        const div = strong.score - weak.score;
        if (div < 0.10) continue;
        const regS = getRegime(data, strong.code);
        const regW = getRegime(data, weak.code);
        const perfect = regS && regW &&
          ["GOLDILOCKS","SURCHAUFFE"].includes(regS.label) &&
          ["RECESSION","STAGFLATION"].includes(regW.label);
        pairs.push({ strong, weak, div, regS, regW, perfect });
      }
    }
    return pairs.sort((a,b) => (b.div + (b.perfect?0.3:0)) - (a.div + (a.perfect?0.3:0)));
  }, [data, withData]);

  const tab = a => ({ padding:"6px 12px", fontSize:11, fontFamily:"monospace", cursor:"pointer", borderRadius:4,
    border: a ? "1px solid #38bdf8" : "1px solid #1e3a5f",
    background: a ? "#38bdf820" : "transparent", color: a ? "#38bdf8" : "#64748b" });

  return (
    <div style={{ minHeight:"100vh", background:"#070b14", fontFamily:"monospace", color:"#c8d8f0", fontSize:13 }}>
      <div style={{ background:"#0a1628", borderBottom:"2px solid #1e3a5f", padding:"12px 16px", display:"flex", alignItems:"center", justifyContent:"space-between", flexWrap:"wrap", gap:8 }}>
        <div>
          <div style={{ fontSize:15, fontWeight:700, letterSpacing:3, color:"#38bdf8" }}>APEX MACRO</div>
          <div style={{ fontSize:9, color:"#475569", letterSpacing:2 }}>FORCE ECONOMIQUE — BIAIS BANQUE CENTRALE</div>
        </div>
        <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
          <button style={tab(view==="table")}   onClick={()=>setView("table")}>TABLEAU</button>
          <button style={tab(view==="rank")}    onClick={()=>setView("rank")}>CLASSEMENT</button>
          <button style={tab(view==="regimes")} onClick={()=>setView("regimes")}>REGIMES</button>
          <button style={tab(view==="trade")}   onClick={()=>setView("trade")}>TRADE</button>
          <button style={tab(view==="data")}    onClick={()=>setView("data")}>DONNEES ↗</button>
          <button style={tab(view==="guide")}   onClick={()=>setView("guide")}>GUIDE</button>
          <button style={tab(view==="cal")}     onClick={()=>setView("cal")}>RESSOURCES</button>
          <button onClick={resetData} style={{ padding:"6px 10px", fontSize:11, fontFamily:"monospace", cursor:"pointer", borderRadius:4, border:"1px solid #7f1d1d", background:"transparent", color:"#ef4444" }}>RESET</button>
        </div>
      </div>

      <div style={{ background:"#090f1e", borderBottom:"1px solid #1e3a5f22", padding:"6px 16px", display:"flex", gap:10, overflowX:"auto" }}>
        {ranked.map(c => { const st=getStr(c.score); const reg=getRegime(data,c.code); return (
          <div key={c.code} style={{ display:"flex", flexDirection:"column", alignItems:"center", minWidth:48 }}>
            <span style={{ fontSize:9, color:st.color, fontWeight:700 }}>{c.code}</span>
            <div style={{ width:36, height:3, background:"#1e3a5f", borderRadius:2, margin:"2px 0" }}>
              <div style={{ width:Math.min(Math.abs(c.score)*100,100)+"%", height:"100%", background:st.color, borderRadius:2 }} />
            </div>
            <span style={{ fontSize:7, color:"#475569" }}>{c.score>=0?"+":""}{c.score.toFixed(2)}</span>
            {reg && <span style={{ fontSize:7, color:reg.color }}>{reg.icon}</span>}
          </div>
        );})}
      </div>

      {view==="table" && (
        <div style={{ overflowX:"auto", padding:12 }}>
          <div style={{ fontSize:9, color:"#475569", marginBottom:6 }}>PRIOR → EXP → NOW (vert=beat / rouge=miss) | Chomage: baisse=vert hausse=rouge</div>
          <table style={{ borderCollapse:"collapse", minWidth:900 }}>
            <thead>
              <tr>
                <th style={{ background:"#0a1628", padding:"6px 10px", fontSize:10, color:"#38bdf8", border:"1px solid #1e3a5f33", textAlign:"left", minWidth:120 }}>PAYS</th>
                {INDS.map(ind => <th key={ind.id} colSpan={3} style={{ background:"#0a1628", padding:"6px 8px", fontSize:10, color:"#38bdf8", border:"1px solid #1e3a5f33", textAlign:"center" }}>{ind.label}</th>)}
                <th style={{ background:"#0a1628", padding:"6px 10px", fontSize:10, color:"#38bdf8", border:"1px solid #1e3a5f33", textAlign:"center", minWidth:80 }}>SCORE</th>
                <th style={{ background:"#0a1628", padding:"6px 10px", fontSize:10, color:"#38bdf8", border:"1px solid #1e3a5f33", textAlign:"center", minWidth:100 }}>FORCE</th>
              </tr>
              <tr>
                <th style={{ background:"#0d1d35", border:"1px solid #1e3a5f22" }} />
                {INDS.map(ind => ["Prior","Exp","Now"].map(f => <th key={ind.id+f} style={{ background:"#0d1d35", padding:"3px 4px", fontSize:8, color:"#475569", border:"1px solid #1e3a5f22", textAlign:"center" }}>{f}</th>))}
                <th style={{ background:"#0d1d35", border:"1px solid #1e3a5f22" }} />
                <th style={{ background:"#0d1d35", border:"1px solid #1e3a5f22" }} />
              </tr>
            </thead>
            <tbody>
              {ranked.map((c,ri) => { const st=getStr(c.score); const reg=getRegime(data,c.code); return (
                <tr key={c.code} style={{ background:ri%2===0?"#0a162810":"transparent" }}>
                  <td style={{ padding:"5px 10px", border:"1px solid #1e3a5f22", fontWeight:700, color:"#e2f0ff", whiteSpace:"nowrap" }}>
                    <span style={{ marginRight:6 }}>{c.flag}</span>
                    <span style={{ fontSize:12, letterSpacing:1 }}>{c.code}</span>
                    <span style={{ fontSize:9, color:"#475569", marginLeft:6 }}>#{ri+1}</span>
                    {reg && <span style={{ fontSize:8, marginLeft:4 }}>{reg.icon}</span>}
                  </td>
                  {INDS.map(ind => ["prior","exp","now"].map(field => (
                    <td key={ind.id+field} style={{ padding:"4px 3px", border:"1px solid #1e3a5f22", textAlign:"center" }}>
                      <Inp code={c.code} id={ind.id} field={field} data={data} setCell={setCell} />
                    </td>
                  )))}
                  <td style={{ padding:"5px 8px", border:"1px solid #1e3a5f22", textAlign:"center" }}>
                    <div style={{ fontSize:15, fontWeight:700, color:st.color }}>{c.score>=0?"+":""}{c.score.toFixed(2)}</div>
                    <div style={{ width:"80%", height:4, background:"#1e3a5f", borderRadius:2, margin:"3px auto 0" }}>
                      <div style={{ width:Math.min(Math.abs(c.score)*100,100)+"%", height:"100%", background:st.color, borderRadius:2 }} />
                    </div>
                  </td>
                  <td style={{ padding:"5px 8px", border:"1px solid #1e3a5f22", textAlign:"center" }}>
                    <div style={{ background:st.bg, border:"1px solid "+st.color+"55", borderRadius:4, padding:"3px 6px", fontSize:10, fontWeight:700, color:st.color }}>{st.label}</div>
                    {reg && <div style={{ fontSize:8, color:reg.color, marginTop:2 }}>{reg.label}</div>}
                  </td>
                </tr>
              );})}
            </tbody>
          </table>
        </div>
      )}

      {view==="rank" && (
        <div style={{ padding:16 }}>
          <div style={{ background:"#0a1628", border:"1px solid #1e3a5f", borderRadius:8, padding:16 }}>
            <div style={{ fontSize:10, letterSpacing:3, color:"#38bdf8", fontWeight:700, marginBottom:12, borderBottom:"1px solid #1e3a5f", paddingBottom:6 }}>CLASSEMENT — FORT → FAIBLE</div>
            {ranked.map((c,i) => { const st=getStr(c.score); const reg=getRegime(data,c.code); return (
              <div key={c.code} style={{ display:"flex", alignItems:"center", gap:10, marginBottom:8, padding:"10px 12px", background:"#070b1466", borderRadius:6, border:"1px solid "+st.color+"33" }}>
                <span style={{ fontSize:18, fontWeight:700, color:"#1e3a5f", minWidth:30 }}>#{i+1}</span>
                <span style={{ fontSize:18 }}>{c.flag}</span>
                <div style={{ minWidth:80 }}>
                  <div style={{ fontWeight:700, color:"#e2f0ff", letterSpacing:2, fontSize:13 }}>{c.code}</div>
                  {reg && <div style={{ fontSize:8, color:reg.color }}>{reg.icon} {reg.label}</div>}
                </div>
                <div style={{ flex:1, height:10, background:"#1e3a5f", borderRadius:5, overflow:"hidden" }}>
                  <div style={{ width:Math.min(Math.abs(c.score)*100,100)+"%", height:"100%", background:st.color, borderRadius:5 }} />
                </div>
                <span style={{ fontSize:15, fontWeight:700, color:st.color, minWidth:52, textAlign:"right" }}>{c.score>=0?"+":""}{c.score.toFixed(2)}</span>
                <div style={{ background:st.bg, border:"1px solid "+st.color+"55", borderRadius:4, padding:"3px 8px", fontSize:10, fontWeight:700, color:st.color, minWidth:60, textAlign:"center" }}>{st.label}</div>
              </div>
            );})}
          </div>
        </div>
      )}

      {view==="regimes" && (
        <div style={{ padding:12 }}>
          <div style={{ fontSize:9, color:"#475569", marginBottom:10 }}>Clique pour voir BANQUE CENTRALE / DEVISE / POURQUOI / ACTION</div>
          {CURR.map(c => <RegimeCard key={c.code} data={data} curr={c} />)}
        </div>
      )}

      {view==="trade" && (
        <div style={{ padding:16 }}>
          {allPairs.length === 0
            ? <div style={{ padding:30, textAlign:"center", color:"#475569", fontSize:11 }}>Pas assez de donnees — entre les chiffres dans le tableau</div>
            : <>
                <div style={{ fontSize:10, letterSpacing:3, color:"#38bdf8", fontWeight:700, marginBottom:12 }}>TOUTES LES PAIRES — HAUTE PROBABILITE</div>
                <div style={{ fontSize:9, color:"#475569", marginBottom:12 }}>Clique sur une paire pour voir l analyse complete</div>
                {allPairs.map((p,idx) => (
                  <TradeCard key={idx} strong={p.strong} weak={p.weak} div={p.div} regS={p.regS} regW={p.regW} perfect={p.perfect} />
                ))}
              </>
          }
        </div>
      )}

      {view==="data"   && <DataView />}
      {view==="guide"  && <GuideView />}
      {view==="cal"    && <CalView />}
    </div>
  );
}
