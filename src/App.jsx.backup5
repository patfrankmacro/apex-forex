import { useState, useMemo } from "react";

const INDS = [
  { id: "mfg",   label: "PMI Manuf",    thresh: 2.0,  rev: false, w: 0.10 },
  { id: "svc",   label: "PMI Services", thresh: 2.0,  rev: false, w: 0.15 },
  { id: "unemp", label: "Chomage %",    thresh: 0.3,  rev: true,  w: 0.20 },
  { id: "rate",  label: "Taux %",       thresh: 0.25, rev: false, w: 0.05 },
  { id: "cpi",   label: "Inflation %",  thresh: 0.3,  rev: false, w: 0.25 },
  { id: "core",  label: "Core CPI %",   thresh: 0.2,  rev: false, w: 0.25 },
];

const TE = "https://tradingeconomics.com";
const TE_LINKS = {
  USD: { mfg:"united-states/manufacturing-pmi", svc:"united-states/services-pmi", unemp:"united-states/unemployment-rate", rate:"united-states/interest-rate", cpi:"united-states/inflation-cpi", core:"united-states/core-inflation-rate" },
  EUR: { mfg:"euro-area/manufacturing-pmi", svc:"euro-area/services-pmi", unemp:"euro-area/unemployment-rate", rate:"euro-area/interest-rate", cpi:"euro-area/inflation-rate", core:"euro-area/core-inflation-rate" },
  CAD: { mfg:"canada/manufacturing-pmi", svc:"canada/services-pmi", unemp:"canada/unemployment-rate", rate:"canada/interest-rate", cpi:"canada/inflation-rate", core:"canada/core-inflation-rate" },
  CHF: { mfg:"switzerland/manufacturing-pmi", svc:"switzerland/services-pmi", unemp:"switzerland/unemployment-rate", rate:"switzerland/interest-rate", cpi:"switzerland/inflation-rate", core:"switzerland/core-inflation-rate" },
  AUD: { mfg:"australia/manufacturing-pmi", svc:"australia/services-pmi", unemp:"australia/unemployment-rate", rate:"australia/interest-rate", cpi:"australia/inflation-rate", core:"australia/core-inflation-rate" },
  JPY: { mfg:"japan/manufacturing-pmi", svc:"japan/services-pmi", unemp:"japan/unemployment-rate", rate:"japan/interest-rate", cpi:"japan/inflation-rate", core:"japan/core-inflation-rate" },
  GBP: { mfg:"united-kingdom/manufacturing-pmi", svc:"united-kingdom/services-pmi", unemp:"united-kingdom/unemployment-rate", rate:"united-kingdom/interest-rate", cpi:"united-kingdom/inflation-rate", core:"united-kingdom/core-inflation-rate" },
  NZD: { mfg:"new-zealand/manufacturing-pmi", svc:"new-zealand/services-pmi", unemp:"new-zealand/unemployment-rate", rate:"new-zealand/interest-rate", cpi:"new-zealand/inflation-rate", core:"new-zealand/core-inflation-rate" },
  CNY: { mfg:"china/manufacturing-pmi", svc:"china/services-pmi", unemp:"china/unemployment-rate", rate:"china/interest-rate", cpi:"china/inflation-rate", core:"china/core-inflation-rate" },
};

const CURR = [
  { code:"USD", flag:"🇺🇸", label:"Etats-Unis" },
  { code:"EUR", flag:"🇪🇺", label:"Zone Euro" },
  { code:"CAD", flag:"🇨🇦", label:"Canada" },
  { code:"CHF", flag:"🇨🇭", label:"Suisse" },
  { code:"AUD", flag:"🇦🇺", label:"Australie" },
  { code:"JPY", flag:"🇯🇵", label:"Japon" },
  { code:"GBP", flag:"🇬🇧", label:"Royaume-Uni" },
  { code:"NZD", flag:"🇳🇿", label:"Nvl-Zelande" },
  { code:"CNY", flag:"🇨🇳", label:"Chine" },
];

function mkData() {
  const d = {};
  CURR.forEach(c => { d[c.code] = {}; INDS.forEach(i => { d[c.code][i.id] = { prior:"", exp:"", now:"" }; }); });
  return d;
}

function toN(v) { const n = parseFloat(v); return isNaN(n) ? null : n; }

function getSurprise(ind, cell) {
  const n = toN(cell.now), e = toN(cell.exp);
  if (n === null || e === null) return null;
  // Chomage: hausse = mauvais = negatif, baisse = bon = positif
  return ind.rev ? -(n - e) : (n - e);
}

function getMag(ind, surp) { return Math.max(-1, Math.min(1, surp / ind.thresh)); }

function calcScore(data, code) {
  let total = 0, wTotal = 0;
  INDS.forEach(ind => {
    const cell = data[code][ind.id];
    // Pour le taux: on compare now vs prior (niveau actuel vs precedent)
    let s;
    if (ind.id === "rate") {
      const now = toN(cell.now), prior = toN(cell.prior);
      if (now === null || prior === null) return;
      s = now - prior; // hausse taux = positif pour devise
    } else {
      s = getSurprise(ind, cell);
    }
    if (s === null) return;
    total += getMag(ind, s) * ind.w;
    wTotal += ind.w;
  });
  return wTotal === 0 ? 0 : total;
}

function cellBg(surp, ind) {
  if (surp === null) return "#111827";
  const m = getMag(ind, surp);
  if (m > 0.5) return "#14532d"; if (m > 0) return "#166534";
  if (m < -0.5) return "#7f1d1d"; if (m < 0) return "#991b1b";
  return "#1f2937";
}

function cellClr(surp, ind) {
  if (surp === null) return "#e2f0ff";
  const m = getMag(ind, surp);
  if (m > 0.5) return "#4ade80"; if (m > 0) return "#86efac";
  if (m < -0.5) return "#f87171"; if (m < 0) return "#fca5a5";
  return "#fbbf24";
}

function getStr(score) {
  if (score >= 0.35)  return { label:"FORT",   color:"#22c55e", bg:"#14532d" };
  if (score >= 0.10)  return { label:"MODERE", color:"#86efac", bg:"#166534" };
  if (score <= -0.35) return { label:"FAIBLE", color:"#ef4444", bg:"#7f1d1d" };
  if (score <= -0.10) return { label:"MODERE", color:"#fca5a5", bg:"#991b1b" };
  return                     { label:"NEUTRE", color:"#fbbf24", bg:"#1f2937" };
}

function getRegime(data, code) {
  // Utilise les magnitudes normalisees pour eviter les faux positifs
  const mfgInd = INDS.find(i=>i.id==="mfg");
  const svcInd = INDS.find(i=>i.id==="svc");
  const cpiInd = INDS.find(i=>i.id==="cpi");
  const coreInd = INDS.find(i=>i.id==="core");
  const unempInd = INDS.find(i=>i.id==="unemp");

  const mfgS = getSurprise(mfgInd, data[code]["mfg"]);
  const svcS = getSurprise(svcInd, data[code]["svc"]);
  const cpiS = getSurprise(cpiInd, data[code]["cpi"]);
  const coreS = getSurprise(coreInd, data[code]["core"]);
  const unempS = getSurprise(unempInd, data[code]["unemp"]);

  // Besoin d'au moins 2 donnees pour determiner le regime
  const growthVals = [mfgS, svcS, unempS].filter(v => v !== null);
  const infVals = [cpiS, coreS].filter(v => v !== null);
  if (growthVals.length === 0 || infVals.length === 0) return null;

  // Moyenne des magnitudes normalisees
  const growthScore = growthVals.reduce((a,b) => {
    const ind = b === mfgS ? mfgInd : b === svcS ? svcInd : unempInd;
    return a + getMag(ind, b);
  }, 0) / growthVals.length;

  const infScore = infVals.reduce((a,b) => {
    const ind = b === cpiS ? cpiInd : coreInd;
    return a + getMag(ind, b);
  }, 0) / infVals.length;

  const growthUp = growthScore > 0;
  const infUp = infScore > 0;

  if (growthUp && !infUp)  return { label:"GOLDILOCKS",  color:"#22c55e",  bg:"#14532d",  icon:"🟢" };
  if (growthUp && infUp)   return { label:"SURCHAUFFE",  color:"#f59e0b",  bg:"#422006",  icon:"🟡" };
  if (!growthUp && infUp)  return { label:"STAGFLATION", color:"#ef4444",  bg:"#7f1d1d",  icon:"🔴" };
  if (!growthUp && !infUp) return { label:"RECESSION",   color:"#f97316",  bg:"#431407",  icon:"🟠" };
  return null;
}

function Inp({ code, id, field, data, setCell }) {
  const cell = data[code][id];
  const ind  = INDS.find(i => i.id === id);
  let surp = null;
  if (field === "now") {
    if (id === "rate") {
      const now = toN(cell.now), prior = toN(cell.prior);
      surp = (now !== null && prior !== null) ? now - prior : null;
    } else {
      surp = getSurprise(ind, cell);
    }
  }
  return (
    <input type="number" step="0.01" value={cell[field]}
      onChange={e => setCell(code, id, field, e.target.value)}
      placeholder="-"
      style={{ width:44, background: field==="now" ? cellBg(surp, ind) : "#111827",
        border:"1px solid #1e3a5f44", borderRadius:3,
        color: field==="now" ? cellClr(surp, ind) : "#94a3b8",
        padding:"3px 2px", fontSize:11, fontFamily:"monospace",
        outline:"none", textAlign:"center", fontWeight: field==="now" ? 700 : 400 }}
    />
  );
}

function RegimeCard({ curr, data }) {
  const [open, setOpen] = useState(false);
  const regime = getRegime(data, curr.code);
  const score = calcScore(data, curr.code);
  const st = getStr(score);

  const regimeExplain = {
    GOLDILOCKS:  { bc:"BC NEUTRE a HAWKISH modere", taux:"Taux stables ou legere hausse", devise:"HAUSSE — croissance sans inflation = economie ideale pour investisseurs", action:"ACHETE la devise — setup ideal" },
    SURCHAUFFE:  { bc:"BC HAWKISH — monte les taux", taux:"Hausse des taux imminente ou en cours", devise:"HAUSSE court terme puis BAISSE si recession crainte", action:"ACHETE la devise mais surveille le retournement" },
    STAGFLATION: { bc:"BC COINCEE — ne peut ni monter ni baisser", taux:"Taux bloques — BC prise en etau", devise:"BAISSE — pire scenario pour une devise", action:"VENDS la devise — evite ce trade en long" },
    RECESSION:   { bc:"BC DOVISH — baisse les taux", taux:"Baisse des taux imminente ou en cours", devise:"BAISSE — economie faible = capitaux fuient", action:"VENDS la devise — short setup" },
  };

  const ex = regime ? regimeExplain[regime.label] : null;

  return (
    <div style={{ marginBottom:8, borderRadius:8, border:"1px solid " + (regime ? regime.color+"44" : "#1e3a5f33"), overflow:"hidden" }}>
      <div onClick={() => setOpen(o=>!o)} style={{ display:"flex", alignItems:"center", gap:10, padding:"10px 14px", background: regime ? regime.bg : "#0a1628", cursor:"pointer" }}>
        <span style={{ fontSize:16 }}>{curr.flag}</span>
        <span style={{ fontWeight:700, color:"#e2f0ff", fontSize:12, letterSpacing:1, minWidth:36 }}>{curr.code}</span>
        <span style={{ fontSize:10, color:"#64748b", flex:1 }}>{curr.label}</span>
        {regime
          ? <span style={{ fontSize:10, fontWeight:700, color:regime.color, background:regime.bg, border:"1px solid "+regime.color+"55", borderRadius:4, padding:"3px 8px" }}>{regime.icon} {regime.label}</span>
          : <span style={{ fontSize:10, color:"#475569" }}>— données manquantes</span>
        }
        <span style={{ fontSize:13, fontWeight:700, color:st.color, minWidth:48, textAlign:"right" }}>{score>=0?"+":""}{score.toFixed(2)}</span>
        <span style={{ fontSize:10, color:"#475569" }}>{open?"▲":"▼"}</span>
      </div>
      {open && regime && ex && (
        <div style={{ padding:"12px 14px", background:"#070b14", borderTop:"1px solid "+regime.color+"22" }}>
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:8, marginBottom:10 }}>
            <div style={{ padding:10, background:regime.bg, borderRadius:6, border:"1px solid "+regime.color+"33" }}>
              <div style={{ fontSize:9, color:regime.color, fontWeight:700, marginBottom:4 }}>BANQUE CENTRALE</div>
              <div style={{ fontSize:10, color:"#e2f0ff" }}>{ex.bc}</div>
            </div>
            <div style={{ padding:10, background:regime.bg, borderRadius:6, border:"1px solid "+regime.color+"33" }}>
              <div style={{ fontSize:9, color:regime.color, fontWeight:700, marginBottom:4 }}>TAUX D INTERET</div>
              <div style={{ fontSize:10, color:"#e2f0ff" }}>{ex.taux}</div>
            </div>
          </div>
          <div style={{ padding:10, background:"#0a1628", borderRadius:6, border:"1px solid "+regime.color+"33", marginBottom:8 }}>
            <div style={{ fontSize:9, color:regime.color, fontWeight:700, marginBottom:4 }}>IMPACT SUR LA DEVISE</div>
            <div style={{ fontSize:10, color:"#e2f0ff" }}>{ex.devise}</div>
          </div>
          <div style={{ padding:10, background:regime.bg, borderRadius:6, border:"1px solid "+regime.color+"55" }}>
            <div style={{ fontSize:9, color:regime.color, fontWeight:700, marginBottom:4 }}>ACTION RECOMMANDEE</div>
            <div style={{ fontSize:11, color:regime.color, fontWeight:700 }}>{ex.action}</div>
          </div>
          <div style={{ marginTop:10 }}>
            <div style={{ fontSize:9, color:"#475569", marginBottom:6, letterSpacing:2 }}>DETAIL INDICATEURS</div>
            {INDS.filter(ind=>ind.id!=="rate").map(ind => {
              const cell = data[curr.code][ind.id];
              const s = getSurprise(ind, cell);
              if (s === null) return null;
              const m = getMag(ind, s);
              const col = m > 0 ? "#4ade80" : m < 0 ? "#f87171" : "#fbbf24";
              return (
                <div key={ind.id} style={{ display:"flex", justifyContent:"space-between", marginBottom:4, padding:"4px 8px", background:"#0a162866", borderRadius:4 }}>
                  <span style={{ fontSize:10, color:"#94a3b8" }}>{ind.label}</span>
                  <span style={{ fontSize:10, fontWeight:700, color:col }}>{m>0?"BEAT ✅":"MISS ❌"} ({s>0?"+":""}{s.toFixed(2)})</span>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}

function DataView() {
  const [selected, setSelected] = useState("USD");
  const curr = CURR.find(c => c.code === selected);
  return (
    <div style={{ padding:16 }}>
      <div style={{ background:"#0a1628", border:"1px solid #38bdf844", borderRadius:8, padding:16, marginBottom:12 }}>
        <div style={{ fontSize:12, letterSpacing:3, color:"#38bdf8", fontWeight:700, marginBottom:8, borderBottom:"1px solid #38bdf833", paddingBottom:8 }}>LIENS TRADING ECONOMICS</div>
        <div style={{ fontSize:10, color:"#64748b", marginBottom:12 }}>
          Clique sur une devise → clique sur l indicateur → tu vois <span style={{color:"#f59e0b"}}>Previous</span> / <span style={{color:"#38bdf8"}}>Consensus</span> / <span style={{color:"#4ade80"}}>Actual</span>
        </div>
        <div style={{ display:"flex", flexWrap:"wrap", gap:6, marginBottom:16 }}>
          {CURR.map(c => (
            <button key={c.code} onClick={() => setSelected(c.code)}
              style={{ padding:"6px 12px", fontSize:11, fontWeight:700, cursor:"pointer", borderRadius:4,
                border: selected===c.code ? "1px solid #38bdf8" : "1px solid #1e3a5f",
                background: selected===c.code ? "#38bdf820" : "#070b14",
                color: selected===c.code ? "#38bdf8" : "#64748b" }}>
              {c.flag} {c.code}
            </button>
          ))}
        </div>
        <div style={{ padding:12, background:"#070b14", borderRadius:6, border:"1px solid #1e3a5f33" }}>
          <div style={{ fontSize:12, fontWeight:700, color:"#e2f0ff", marginBottom:12 }}>{curr.flag} {curr.code} — {curr.label}</div>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill, minmax(160px, 1fr))", gap:8 }}>
            {INDS.map(ind => (
              <a key={ind.id} href={TE+"/"+TE_LINKS[curr.code][ind.id]} target="_blank" rel="noopener noreferrer"
                style={{ display:"flex", flexDirection:"column", padding:"10px 12px", borderRadius:6,
                  background:"#0a1628", border:"1px solid #38bdf833", color:"#38bdf8", textDecoration:"none" }}>
                <span style={{ fontSize:11, fontWeight:700, marginBottom:4 }}>{ind.label} ↗</span>
                <span style={{ fontSize:8, color:"#475569" }}>{TE_LINKS[curr.code][ind.id]}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div style={{ background:"#0a1628", border:"1px solid #f59e0b44", borderRadius:8, padding:16 }}>
        <div style={{ fontSize:12, letterSpacing:3, color:"#f59e0b", fontWeight:700, marginBottom:8, borderBottom:"1px solid #f59e0b33", paddingBottom:8 }}>COMMENT SAISIR</div>
        {[["Previous","#f59e0b","Le chiffre du mois dernier → colonne PRIOR"],["Consensus","#38bdf8","Ce que les economistes prevoient → colonne EXP"],["Actual","#4ade80","Le chiffre publie → colonne NOW"]].map(([k,col,v]) => (
          <div key={k} style={{ display:"flex", gap:12, marginBottom:8 }}>
            <div style={{ fontSize:10, fontWeight:700, color:col, minWidth:80 }}>{k}</div>
            <div style={{ fontSize:10, color:"#94a3b8" }}>{v}</div>
          </div>
        ))}
        <div style={{ marginTop:12, padding:10, background:"#070b14", borderRadius:6, border:"1px solid #f59e0b33" }}>
          <div style={{ fontSize:10, fontWeight:700, color:"#f59e0b", marginBottom:6 }}>⚠️ TAUX D INTERET — SPECIAL</div>
          <div style={{ fontSize:10, color:"#94a3b8" }}>Pour le Taux %: entre le taux actuel dans NOW et le taux du mois precedent dans PRIOR. Pas de colonne EXP pour le taux — la hausse vs baisse est ce qui compte.</div>
        </div>
      </div>
    </div>
  );
}

